t() { local k=$1; shift; printf -- "$T[$k]" "$@" }

human() {
  local k=${1:-0}
  if (( k >= 1048576 )); then printf "%.1f $T[gb]" $(( k / 1048576.0 ))
  elif (( k >= 1024 )); then printf "%.1f $T[mb]" $(( k / 1024.0 ))
  else printf "%d $T[kb]" $k; fi
}

sizek() { (( $# )) || { echo 0; return }; du -sk "$@" 2>/dev/null | awk '{s+=$1} END{print s+0}' }

to_kb() {
  awk -v s="$1" 'BEGIN {
    if (!match(s, /[0-9.]+/)) { print 0; exit }
    n = substr(s, RSTART, RLENGTH); u = toupper(substr(s, RSTART + RLENGTH)); m = 1 / 1024
    if (u ~ /^ *K/) m = 1; else if (u ~ /^ *M/) m = 1024; else if (u ~ /^ *G/) m = 1048576; else if (u ~ /^ *T/) m = 1073741824
    printf "%d\n", n * m
  }'
}

bar() {
  local val=$1 max=$2 width=${3:-20} col=${4:-$C}
  (( max > 0 )) || max=1
  local fill=$(( val * width / max ))
  (( val > 0 && fill == 0 )) && fill=1
  (( fill > width )) && fill=$width
  print -n "${col}${(l:fill::█:)}${N}${D}${(l:width-fill::░:)}${N}"
}

gauge_col() { (( $1 >= 85 )) && print -n $R || { (( $1 >= 60 )) && print -n $Y || print -n $G } }

star_line() {
  local w=${1:-44} line="" i
  for (( i = 0; i < w; i++ )); do
    if (( RANDOM % 9 == 0 )); then
      line+="\e[38;5;$(( RANDOM % 2 ? 228 : 255 ))m${STARS[RANDOM % ${#STARS} + 1]}${N}"
    else
      line+=" "
    fi
  done
  print -n "  $line"
}

LOGO=(
  "┌┬┐┌─┐┌─┐   ┌─┐┬  ┌─┐┌─┐┌┐┌┌─┐┬─┐"
  "│││├─┤│  ───│  │  ├┤ ├─┤│││├┤ ├┬┘"
  "┴ ┴┴ ┴└─┘   └─┘┴─┘└─┘┴ ┴┘└┘└─┘┴└─"
)

logo_lines() {
  local l i w=${#LOGO[1]} out
  for l in $LOGO; do
    out="     "
    for (( i = 1; i <= ${#l}; i++ )); do
      if [[ -n $FANCY ]]; then out+="\e[38;5;${GRAD[(i - 1) * ${#GRAD} / w + 1]}m${l[i]}"
      else out+=${l[i]}; fi
    done
    print "$out${N}"
  done
}

draw_logo() {
  if [[ -z $FANCY ]]; then logo_lines; return; fi
  local logo=$(logo_lines) f frames=${1:-1}
  print -n "\e[?25l"
  for (( f = 1; f <= frames; f++ )); do
    (( f > 1 )) && print -n "\e[6A"
    star_line; print
    print "$logo"
    star_line; print
    print "     ${D}v$VERSION · $T[tagline]${N}"
    (( f < frames )) && sleep 0.07
  done
  print -n "\e[?25h"
}

spin() {
  local msg=$1; shift
  if [[ -z $FANCY ]]; then "$@"; return; fi
  local tmp=$(mktemp -t mac-cleaner)
  "$@" >$tmp 2>/dev/null &
  local pid=$! i=0 frames=(✶ ✷ ✸ ✹ ✺ ✹ ✸ ✷)
  print -n "\e[?25l" >&2
  while kill -0 $pid 2>/dev/null; do
    printf "\r  ${Y}%s${N} ${D}%s${N}" ${frames[i++ % ${#frames} + 1]} "$msg" >&2
    sleep 0.08
  done
  wait $pid
  print -n "\r\e[2K\e[?25h" >&2
  cat $tmp; rm -f $tmp
}

confirm() {
  if [[ -n $YES || -n $DRY_RUN ]]; then print "  ${M}?${N} $1 ${M}›${N} ${D}(${${DRY_RUN:+--dry-run}:---yes})${N}"; return 0; fi
  local r; read "r?  ${M}?${N} $1 ${D}($T[yn])${N} ${M}›${N} "; [[ $r == ${~T[yes]} ]]
}

ask() { local __v; read "__v?  ${M}?${N} $2 ${M}›${N} "; : ${(P)1::=$__v} }

key() {
  local __k
  if [[ -t 0 ]]; then read -s -k1 "__k?$2"; else read -k1 -u0 "__k?$2"; fi || return 1
  : ${(P)1::=$__k}
}

pause() { local r; key r "  ${D}$T[back]${N}"; print }

pick_idx() {
  local sel=$1 n=$2 i
  (( n > 0 )) || return 0
  if [[ $sel == ${~T[all_key]} ]]; then seq 1 $n; return; fi
  for i in ${(u)=sel}; do [[ $i == <1-> && $i -le $n ]] && print $i; done
}

title() {
  local t=" ✦ $1 " w=56
  print "\n  ${M}${B}${t}${N}${D}${(l:w-${#t}::─:)}${N}\n"
  [[ -n $DRY_RUN ]] && print "  ${Y}✦ $T[dry_badge]${N}\n"
}

ok() { print "  ${G}✔${N} $*" }
warn() { print "  ${Y}!${N} $*" }
err() { print "  ${R}✘${N} $*" }
dry() { print "  ${D}$(t dry_line "$*")${N}" }

act_q() {
  if [[ -n $DRY_RUN ]]; then dry "$*"; return 0; fi
  "$@" >/dev/null 2>&1
}

celebrate() {
  local msg=$1 f
  if [[ -n $DRY_RUN ]]; then ok "$T[dry_done]"; return; fi
  if [[ -z $FANCY ]]; then print "  * $msg *"; return; fi
  local -a cols=(228 221 215 213 177 141 117 228)
  print -n "\e[?25l"
  for f in {1..8}; do
    printf "\r  \e[38;5;%dm★ ✦ ⋆${N}  ${B}%s${N}  \e[38;5;%dm⋆ ✦ ★${N}" ${cols[f]} "$msg" ${cols[9-f]}
    sleep 0.06
  done
  print "\e[?25h"
}

log_hist() {
  [[ -n $DRY_RUN ]] && return 0
  mkdir -p ${HIST_FILE:h} 2>/dev/null
  print -r -- "$(date '+%F %H:%M')	$1	${2:-0}	$3" >> $HIST_FILE
}

to_trash() {
  local p dest
  for p in "$@"; do
    [[ -e $p ]] || continue
    if [[ -n $DRY_RUN ]]; then dry "→ $T[trash_title] : ${p/#$HOME/~}"; continue; fi
    if [[ -n $MAC_CLEANER_TRASH_DIR ]]; then
      dest=$MAC_CLEANER_TRASH_DIR/${p:t}
      [[ -e $dest ]] && dest+=" $RANDOM"
      mv "$p" "$dest" 2>/dev/null || err "$(t mv_fail "$p")"
    else
      trash "$p" 2>/dev/null || osascript -e "tell application \"Finder\" to delete POSIX file \"$p\"" >/dev/null 2>&1 \
        || sudo mv "$p" "$TRASH_DIR/" 2>/dev/null || err "$(t mv_fail "$p")"
    fi
  done
}

empty_trash() {
  if [[ -n $DRY_RUN ]]; then dry "$T[trash_ask]"; return 0; fi
  if [[ -n $MAC_CLEANER_TRASH_DIR ]]; then rm -rf "$MAC_CLEANER_TRASH_DIR"/*(DN)
  else osascript -e 'tell application "Finder" to empty trash' >/dev/null 2>&1; fi
}

disk_stats() { df -k /System/Volumes/Data | awk 'NR==2{print $2, $4}' }

mem_free() { memory_pressure 2>/dev/null | awk -F': ' '/free percentage/{gsub("%","",$2); print $2}' }

overview() {
  local -a ds=( $(disk_stats) )
  local dpct=$(( (ds[1] - ds[2]) * 100 / ds[1] )) mfree=$(mem_free)
  local mpct=$(( 100 - ${mfree:-0} ))
  printf "\n  ${D}%-6s${N}  %s ${B}%3d%%${N} ${D}· %s${N}\n" "$T[disk]" "$(bar $dpct 100 24 $(gauge_col $dpct))" $dpct "$(t disk_free "$(human $ds[2])")"
  printf "  ${D}%-6s${N}  %s ${B}%3d%%${N} ${D}· %s${N}\n" "$T[ram]" "$(bar $mpct 100 24 $(gauge_col $mpct))" $mpct "$(t ram_free "$mfree")"
}

do_ram() {
  title "$T[ram]"
  local before=$(mem_free)
  print "  ${B}$(t ram_free_now $before)${N}\n"
  print "  ${D}$T[top_procs]${N}"
  local -a procs=( ${(f)"$(ps -axmo rss=,comm= | head -8)"} )
  local max=${${procs[1]## #}%% *} p rss cmd
  for p in $procs; do
    rss=${${p## #}%% *}; cmd=${${p## #}#* }
    printf "  %s %9s  %s\n" "$(bar $rss $max 16 $M)" "$(human $rss)" "${cmd:t}"
  done
  print
  confirm "$T[ram_ask]" || return 0
  if [[ -n $DRY_RUN ]]; then dry "sudo purge"; celebrate; return 0; fi
  sudo -p "  ${D}$T[sudo_prompt]${N} " true || return 0
  spin "$T[ram_spin]" sudo purge
  local after=$(mem_free)
  log_hist m1 0 "$before% → $after%"
  celebrate "$(t ram_done $before $after)"
}

do_trash() {
  title "$T[trash_title]"
  local k=$(spin "$T[trash_spin]" sizek $TRASH_DIR/*(DN))
  print "  $(t trash_size "${B}$(human $k)${N}")"
  (( k == 0 )) && print "  ${D}$T[trash_zero]${N}"
  print
  confirm "$T[trash_ask]" || return 0
  if [[ -n $DRY_RUN ]]; then empty_trash; celebrate; return 0; fi
  if spin "$T[trash_emptying]" empty_trash; then
    log_hist m2 $k
    celebrate "$(t trash_done "$(human $k)")"
  else
    err "$T[trash_fail]"
  fi
}

LIB_DIRS=(
  ~/Library/"Application Support" ~/Library/Caches ~/Library/Preferences ~/Library/Containers
  ~/Library/"Group Containers" ~/Library/Logs ~/Library/"Saved Application State" ~/Library/HTTPStorages
  ~/Library/WebKit ~/Library/LaunchAgents ~/Library/Cookies ~/Library/"Application Scripts"
  /Library/"Application Support" /Library/Caches /Library/Preferences /Library/LaunchAgents /Library/LaunchDaemons
)

leftovers() {
  local app=$1 name=$2 bid=$3 d
  local -a expr
  [[ -n $bid ]] && expr=( -name "$bid" -o -name "$bid.*" -o -name "*.$bid" -o -name "*.$bid.*" -o )
  print -r -- "$app"
  for d in $LIB_DIRS; do
    [[ -d $d ]] || continue
    find "$d" -mindepth 1 -maxdepth 1 \( $expr -iname "$name" -o -iname "$name.*" \) 2>/dev/null
  done
}

do_uninstall() {
  title "$T[m3]"
  local filter
  ask filter "$T[un_filter]"
  local -a apps
  apps=( /Applications/*.app ~/Applications/*.app )
  [[ -n $filter ]] && apps=( ${(M)apps:#(#i)*${filter}*} )
  (( ${#apps} )) || { warn "$T[un_none]"; return 0 }
  print
  local i=1 a
  for a in $apps; do printf "  ${M}%3d${N}  %s\n" $i "${a:t:r}"; (( i++ )); done
  print
  local n
  ask n "$T[un_pick]"
  [[ $n == <1-> && $n -le ${#apps} ]] || return 0
  local app=$apps[$n] name=${apps[$n]:t:r}
  local bid=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$app/Contents/Info.plist" 2>/dev/null)
  [[ $bid == com.apple.* ]] && { err "$T[un_apple]"; return 0 }

  local -a found=( ${(u)${(f)"$(spin "$(t un_spin $name)" leftovers "$app" "$name" "$bid")"}:#} )
  local -a sizes
  local f max=0 total=0 k
  for f in $found; do k=$(sizek "$f"); sizes+=( $k ); (( total += k, k > max ? (max = k) : 0 )); done

  print "\n  ${B}$name${N} ${D}· $bid${N}\n"
  for i in {1..${#found}}; do
    printf "  %s %9s  %s\n" "$(bar ${sizes[i]} $max 12)" "$(human ${sizes[i]})" "${found[i]/#$HOME/~}"
  done
  print "\n  ${B}$(t total "$(human $total)")${N}\n"
  confirm "$T[un_ask]" || return 0
  [[ -n $bid && -z $DRY_RUN ]] && osascript -e "quit app id \"$bid\"" >/dev/null 2>&1
  to_trash $found
  log_hist m3 $total "$name"
  celebrate "$(t un_done $name "$(human $total)")"
}

large_scan() {
  local min=$1 f
  find "$HOME" -xdev \( -path "$HOME/Library" -o -path "$HOME/.Trash" -o -name "*.app" \) -prune -o -type f -size +${min}M -print 2>/dev/null \
    | while IFS= read -r f; do print -r -- "$(stat -f '%z' "$f")	$f"; done \
    | sort -t$'\t' -k1,1nr | head -40
}

do_large() {
  title "$T[m4]"
  local min
  ask min "$T[lg_min] ${D}[500]${N}"
  [[ $min == <1-> ]] || min=500
  local -a rows=( ${(f)"$(spin "$T[lg_spin]" large_scan $min)"} )
  rows=( ${rows:#} )
  (( ${#rows} )) || { warn "$(t lg_none $min)"; return 0 }
  local -a paths psz
  local i=1 r max=${rows[1]%%$'\t'*} sz
  for r in $rows; do
    paths+=( "${r#*$'\t'}" ); sz=${r%%$'\t'*}; psz+=( $(( sz / 1024 )) )
    printf "  ${M}%3d${N} %s %9s  %s\n" $i "$(bar $(( sz / 1024 )) $(( max / 1024 )) 12)" "$(human $(( sz / 1024 )))" "${${r#*$'\t'}/#$HOME/~}"
    (( i++ ))
  done
  print
  local sel
  ask sel "$T[pick]"
  local -a pick
  local k=0
  for i in $(pick_idx "$sel" ${#paths}); do pick+=( "${paths[i]}" ); (( k += psz[i] )); done
  (( ${#pick} )) || return 0
  confirm "$(t lg_ask ${#pick} "$(human $k)")" || return 0
  to_trash $pick
  log_hist m4 $k
  celebrate "$(t lg_done "$(human $k)")"
}

CACHE_KEYS=(apps logs xcode devsupport sim npm composer gradle brew docker nodemod)
SAFE_KEYS=(apps logs xcode sim npm composer gradle brew)
typeset -A CDIR
CDIR=(
  apps "$HOME/Library/Caches" logs "$HOME/Library/Logs" xcode "$HOME/Library/Developer/Xcode/DerivedData"
  devsupport "$HOME/Library/Developer/Xcode/iOS DeviceSupport" sim "$HOME/Library/Developer/CoreSimulator/Caches"
  npm "$HOME/.npm/_cacache" composer "$HOME/.composer/cache" gradle "$HOME/.gradle/caches"
)

typeset -A RUN_SET
typeset -a RUN_IDS RUN_APPS CA_DEL CA_KEEP
RUN_LOADED=

load_running() {
  [[ -n $RUN_LOADED ]] && return 0
  RUN_LOADED=1
  local c app bid
  local -A seen
  for c in ${(f)"$(ps -axo comm= 2>/dev/null)"}; do
    RUN_SET[${(L)c:t}]=1
    [[ $c == *.app/Contents/* ]] || continue
    for app in "${c%%.app/Contents/*}.app" "${c%.app/Contents/*}.app"; do
      (( $+seen[$app] )) && continue
      seen[$app]=1
      RUN_APPS+=( ${(L)app:t:r} )
      bid=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$app/Contents/Info.plist" 2>/dev/null) && RUN_IDS+=( ${(L)bid} )
    done
  done
  RUN_IDS=( ${(u)RUN_IDS} ) RUN_APPS=( ${(u)RUN_APPS} )
  for c in $RUN_IDS $RUN_APPS; do RUN_SET[$c]=1; done
}

in_use() {
  load_running
  local n=${(L)${1%.code_sign_clone}} k
  (( $+RUN_SET[$n] )) && return 0
  [[ $n == *.* ]] && (( $+RUN_SET[${n##*.}] )) && return 0
  for k in $RUN_IDS; do [[ $n == ${(b)k}.* || $k == ${(b)n}.* ]] && return 0; done
  for k in $RUN_APPS; do [[ $k == ${(b)n}\ * ]] && return 0; done
  return 1
}

open_filter() {
  local cand=$(mktemp -t mac-cleaner)
  cat > $cand
  lsof -nP -w -Fn 2>/dev/null | awk -v cand="$cand" '
    BEGIN { while ((getline l < cand) > 0) { c[l] = 1; o[++n] = l } }
    /^n\// { p = substr($0, 2); while (p != "") { if (p in c) u[p] = 1; sub(/\/[^\/]*$/, "", p) } }
    END { for (i = 1; i <= n; i++) if (!(o[i] in u)) print o[i] }'
  rm -f $cand
}

apps_split() {
  CA_DEL=() CA_KEEP=()
  local e
  for e in $CDIR[apps]/*(DN); do
    if in_use ${e:t}; then CA_KEEP+=( "$e" ); else CA_DEL+=( "$e" ); fi
  done
}

skip_note() {
  local key=$1; shift
  (( $# )) || return 0
  local -a n=( ${@:t} )
  local s=${(j:, :)n[1,8]}
  (( $# > 8 )) && s+=" $(t te_more $(( $# - 8 )))"
  print "  ${D}$(t $key "$s")${N}"
}

cache_avail() {
  [[ " $MAC_CLEANER_SKIP " == *" $1 "* ]] && return 1
  case $1 in
    brew) (( $+commands[brew] )) ;;
    docker) (( $+commands[docker] )) && docker info >/dev/null 2>&1 ;;
    nodemod) return 0 ;;
    *) [[ -d $CDIR[$1] ]] ;;
  esac
}

brew_kb() { to_kb "$(brew cleanup -n -s 2>/dev/null | awk '/free approximately/{print $(NF-3)}')" }

docker_kb() {
  local l s=0
  for l in ${(f)"$(docker system df --format '{{.Type}}|{{.Reclaimable}}' 2>/dev/null)"}; do
    [[ $l == Local\ Volumes* || -z $l ]] && continue
    (( s += $(to_kb "${${l#*|}%% *}") ))
  done
  print $s
}

nm_scan() {
  local root nm
  for root in ${(s.:.)${MAC_CLEANER_PROJECTS:-$HOME}}; do
    [[ -d $root ]] || continue
    find "$root" -maxdepth 6 \( -path "$HOME/Library" -o -path "$HOME/.Trash" -o -name .git \) -prune -o -type d -name node_modules -prune -print 2>/dev/null
  done | while IFS= read -r nm; do
    [[ -z $(find "${nm:h}" -mindepth 1 -maxdepth 2 -not -path '*/node_modules*' -not -path '*/.git*' -mtime -90 -print -quit 2>/dev/null) ]] && print -r -- "$nm"
  done
}

nm_paths() { local -a l=( ${(f)"$(<$NM_LIST)"} ); print -rl -- ${l:#} }

cache_kb() {
  case $1 in
    brew) brew_kb ;;
    docker) docker_kb ;;
    nodemod) nm_scan > $NM_LIST; local -a l=( ${(f)"$(nm_paths)"} ); sizek ${l:#} ;;
    apps) sizek $CA_DEL ;;
    *) sizek $CDIR[$1]/*(DN) ;;
  esac
}

scan_caches() { local k; for k in "$@"; do cache_avail $k && print -r -- "$k	$(cache_kb $k)"; done }

cache_label() {
  if [[ $1 == nodemod ]]; then local -a l=( ${(f)"$(nm_paths)"} ); t c_nodemod ${#${l:#}}
  else print -n "$T[c_$1]"; fi
}

cache_clean() {
  local k=$1 d
  case $k in
    brew) act_q brew cleanup -s ;;
    docker) act_q docker system prune -af ;;
    nodemod) for d in ${(f)"$(nm_paths)"}; do [[ $d == */node_modules ]] && act_q rm -rf "$d"; done ;;
    apps)
      if [[ -n $DRY_RUN ]]; then dry "rm -rf ${CDIR[apps]/#$HOME/~}/… (${#CA_DEL}) · ${#CA_KEEP} $T[ca_kept]"; return 0; fi
      for d in $CA_DEL; do [[ $d == $CDIR[apps]/?* ]] && rm -rf "$d" 2>/dev/null; done
      ;;
    *)
      d=$CDIR[$k]
      [[ -d $d && $d == $HOME/?* ]] || return 0
      if [[ -n $DRY_RUN ]]; then dry "rm -rf ${d/#$HOME/~}/*"; else rm -rf "$d"/*(DN) 2>/dev/null; fi
      ;;
  esac
}

do_caches() {
  title "$T[ca_title]"
  NM_LIST=$(mktemp -t mac-cleaner)
  apps_split
  local -a rows=( ${(f)"$(spin "$T[ca_spin]" scan_caches $CACHE_KEYS)"} ) keys sizes
  rows=( ${rows:#} )
  local r i total=0 max=0
  for r in $rows; do keys+=( ${r%%$'\t'*} ); sizes+=( ${r#*$'\t'} ); done
  (( ${#keys} )) || { rm -f $NM_LIST; return 0 }
  for i in {1..${#keys}}; do (( total += sizes[i], sizes[i] > max ? (max = sizes[i]) : 0 )); done
  for i in {1..${#keys}}; do
    printf "  ${M}%3d${N} %s %9s  %s\n" $i "$(bar ${sizes[i]} $max 16)" "$(human ${sizes[i]})" "$(cache_label ${keys[i]})"
  done
  print
  skip_note ca_skip $CA_KEEP
  print "\n  ${B}$(t total "$(human $total)")${N}\n"
  local sel freed=0
  ask sel "$T[ca_pick]"
  for i in $(pick_idx "$sel" ${#keys}); do
    cache_clean ${keys[i]}
    (( freed += sizes[i] ))
    ok "$(cache_label ${keys[i]})"
  done
  rm -f $NM_LIST
  (( freed )) || return 0
  print
  log_hist m5 $freed
  celebrate "$(t ca_done "$(human $freed)")"
  [[ -z $DRY_RUN ]] && print "  ${D}$T[ca_note]${N}"
}

sel_idx() {
  if [[ -n $DRY_RUN || -n $YES ]]; then (( $1 )) && seq 1 $1; return 0; fi
  local sel
  ask sel "$2"
  pick_idx "$sel" $1
}

TEMP_DAYS=${MAC_CLEANER_TEMP_DAYS:-3}
DEV_DAYS=${MAC_CLEANER_DEV_DAYS:-14}
typeset -a TE_PATHS TE_KEEP TE_TMP TE_CLONE
TE_KB=0

temp_roots() {
  local -a r
  local d
  if [[ -n $MAC_CLEANER_TMP_DIRS ]]; then r=( ${(s.:.)MAC_CLEANER_TMP_DIRS} )
  else r=( /private/tmp ${TMPDIR:-$(getconf DARWIN_USER_TEMP_DIR 2>/dev/null)} ); fi
  for d in $r; do [[ -d $d ]] && print -r -- ${d:A}; done | sort -u
}

clone_dirs() {
  local -a r
  local d
  if [[ -n $MAC_CLEANER_CLONE_DIRS ]]; then r=( ${(s.:.)MAC_CLEANER_CLONE_DIRS} )
  else r=( /private/var/folders/*/*/X(N/) ); [[ -n $TMPDIR ]] && r+=( ${TMPDIR:A:h}/X ); fi
  for d in $r; do [[ -d $d && -r $d ]] && print -r -- ${d:A}; done | sort -u
}

temp_list() {
  local root e
  for root in ${(f)"$(temp_roots)"}; do
    find "$root" -mindepth 1 -maxdepth 1 -user $UID \( -type f -o -type d \) -mtime +$TEMP_DAYS \
      -not -name '.*' -not -name 'com.apple.*' -not -name TemporaryItems -not -name 'mac-cleaner*' 2>/dev/null |
    while IFS= read -r e; do
      [[ -d $e && -n $(find "$e" -mtime -$TEMP_DAYS -print -quit 2>/dev/null) ]] && continue
      print -r -- "tmp	$e"
    done
  done
  for root in ${(f)"$(clone_dirs)"}; do
    for e in $root/*.code_sign_clone(DN); do
      if in_use ${e:t}; then print -r -- "keep	$e"; else print -r -- "clone	$e"; fi
    done
  done
}

temp_scan() {
  local -a rows=( ${(f)"$(temp_list)"} )
  local -A kind
  local r
  for r in $rows; do kind[${r#*$'\t'}]=${r%%$'\t'*}; done
  for r in ${(f)"$(for r in $rows; do [[ $r == keep* ]] || print -r -- ${r#*$'\t'}; done | open_filter)"}; do
    [[ -n $r ]] && print -r -- "$kind[$r]	$(sizek "$r")	$r"
  done
  for r in ${(M)rows:#keep*}; do print -r -- "keep	0	${r#*$'\t'}"; done
}

temp_collect() {
  TE_PATHS=() TE_KEEP=() TE_TMP=() TE_CLONE=() TE_KB=0
  load_running
  local -a rows=( ${(f)"$(spin "$T[te_spin]" temp_scan)"} )
  local r k sz p
  for r in ${rows:#}; do
    k=${r%%$'\t'*}; r=${r#*$'\t'}; sz=${r%%$'\t'*}; p=${r#*$'\t'}
    case $k in
      keep) TE_KEEP+=( "$p" ) ;;
      tmp) TE_TMP+=( "$sz	$p" ); TE_PATHS+=( "$p" ); (( TE_KB += sz )) ;;
      clone) TE_CLONE+=( "$sz	$p" ); TE_PATHS+=( "$p" ); (( TE_KB += sz )) ;;
    esac
  done
  TE_TMP=( ${(On)TE_TMP} ) TE_CLONE=( ${(On)TE_CLONE} )
}

temp_group() {
  local label=$1 r sum=0 i=0 max; shift
  (( $# )) || return 0
  for r in "$@"; do (( sum += ${r%%$'\t'*} )); done
  max=${1%%$'\t'*}
  printf "  ${B}%9s${N}  ${B}%s${N}\n" "$(human $sum)" "$label"
  for r in "$@"; do
    (( ++i > 6 )) && { print "  ${D}$(t te_more $(( $# - 6 )))${N}"; break }
    printf "  %s %9s  ${D}%s${N}\n" "$(bar ${r%%$'\t'*} $max 8)" "$(human ${r%%$'\t'*})" "${${r#*$'\t'}/#$HOME/~}"
  done
  print
}

temp_show() {
  temp_group "$(t te_tmp $TEMP_DAYS ${#TE_TMP})" $TE_TMP
  temp_group "$(t te_clone ${#TE_CLONE})" $TE_CLONE
  skip_note te_skip $TE_KEEP
}

temp_clean() {
  local p root ok n=0
  local -a roots=( ${(f)"$(temp_roots)"} ${(f)"$(clone_dirs)"} )
  for p in $TE_PATHS; do
    ok=
    for root in $roots; do [[ $p == $root/?* ]] && ok=1; done
    [[ -n $ok ]] || continue
    if [[ -n $DRY_RUN ]]; then
      (( ++n <= 10 )) && dry "rm -rf ${p/#$HOME/~}"
    else
      rm -rf -- "$p" 2>/dev/null
    fi
  done
  (( n > 10 )) && print "  ${D}$(t te_more $(( n - 10 )))${N}"
  return 0
}

free_kb() { local -a d=( $(disk_stats) ); print ${d[2]:-0} }

do_temp() {
  title "$T[mt]"
  temp_collect
  temp_show
  (( ${#TE_PATHS} )) || { ok "$T[te_none]"; return 0 }
  print "  ${B}$(t total "$(human $TE_KB)")${N}"
  print "  ${D}$T[te_note]${N}\n"
  confirm "$T[te_ask]" || return 0
  local before=$(free_kb)
  temp_clean
  [[ -n $DRY_RUN ]] && { celebrate; return 0 }
  sync
  local real=$(( $(free_kb) - before ))
  (( real < 0 )) && real=0
  log_hist mt $real
  print "  $(t te_done "${B}$(human $real)${N}" "$(human $TE_KB)")"
  celebrate "$(t dv_done "$(human $real)")"
}

dev_roots() { print -rl -- ${(s.:.)${MAC_CLEANER_PROJECTS:-$HOME}} }

git_repos() {
  local root g
  for root in ${(f)"$(dev_roots)"}; do
    [[ -d $root ]] || continue
    find "$root" -maxdepth 5 \( -name Library -o -name node_modules -o -name .Trash -o -name Temp \) -prune -o -name .git -type d -prune -print 2>/dev/null
  done | while IFS= read -r g; do print -r -- ${g:h:A}; done | sort -u
}

wt_scan() {
  local repo=$1 now=$(date +%s) r wt br head lock pr b st gd act m age reason first=1
  local -a bases recs
  for b in main master; do git -C "$repo" show-ref -q --verify refs/heads/$b && bases+=( $b ); done
  b=$(git -C "$repo" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null) && bases+=( $b )
  recs=( ${(f)"$(git -C "$repo" worktree list --porcelain 2>/dev/null | awk 'BEGIN { RS = ""; FS = "\n" } {
    wt = br = hd = ""; lk = pr = 0
    for (i = 1; i <= NF; i++) {
      if ($i ~ /^worktree /) wt = substr($i, 10)
      else if ($i ~ /^branch /) { br = substr($i, 8); sub(/^refs\/heads\//, "", br) }
      else if ($i ~ /^HEAD /) hd = substr($i, 6)
      else if ($i ~ /^locked/) lk = 1
      else if ($i ~ /^prunable/) pr = 1
    }
    print wt "\t" (br == "" ? "-" : br) "\t" hd "\t" lk "\t" pr }')"} )
  for r in $recs; do
    IFS=$'\t' read -r wt br head lock pr <<< "$r"
    if (( first )); then first=0; (( ${#bases} )) || { [[ $br != - ]] && bases+=( $br ) }; continue; fi
    [[ $lock == 0 && $pr == 0 && -d $wt ]] || continue
    st=$(GIT_OPTIONAL_LOCKS=0 git -C "$wt" status --porcelain 2>/dev/null) || continue
    [[ -z $st ]] || continue
    gd=$(git -C "$wt" rev-parse --absolute-git-dir 2>/dev/null) || continue
    act=$(git -C "$wt" log -1 --format=%ct HEAD 2>/dev/null); act=${act:-0}
    for m in $gd/HEAD $gd/index; do m=$(stat -f %m "$m" 2>/dev/null) && (( m > act )) && act=$m; done
    (( now - act < 86400 )) && continue
    age=$(( (now - act) / 86400 )) reason=
    for b in $bases; do git -C "$repo" merge-base --is-ancestor "$head" "$b" 2>/dev/null && { reason="merged:$b"; break }; done
    [[ -z $reason ]] && (( age >= DEV_DAYS )) && reason="idle:$age"
    [[ -n $reason ]] && print -r -- "${wt:A}	$repo	$br	$reason"
  done
  b=$(git -C "$repo" worktree prune -n 2>&1 | grep -c .)
  (( b )) && print -r -- "prune	$b	$repo"
  return 0
}

unity_projects() {
  local root f
  for root in ${(f)"$(dev_roots)"}; do
    [[ -d $root ]] || continue
    find "$root" -maxdepth 7 \( -name Library -o -name node_modules -o -name .git -o -name Temp -o -name Assets \) -prune -o -path '*/ProjectSettings/ProjectVersion.txt' -print 2>/dev/null
  done | while IFS= read -r f; do
    f=${f:h:h:A}
    [[ -d $f/Assets && -d $f/Library ]] && print -r -- $f
  done | sort -u
}

unity_idle() {
  local p=$1 l
  for l in ${(f)2}; do [[ $l == (#i)*unity* && $l == *${(b)p}* ]] && return 1; done
  [[ -z $(find "$p" \( -path "$p/Library" -o -path "$p/Temp" -o -path "$p/Logs" -o -path "$p/obj" -o -name .git \) -prune -o -mtime -$DEV_DAYS -print -quit 2>/dev/null) ]]
}

dev_scan() {
  local repo r p psa
  local -a wt un
  local -A meta
  for repo in ${(f)"$(git_repos)"}; do
    for r in ${(f)"$(wt_scan "$repo")"}; do
      [[ -z $r ]] && continue
      [[ $r == prune* ]] && { print -r -- "$r"; continue }
      wt+=( "${r%%$'\t'*}" ); meta[${r%%$'\t'*}]=${r#*$'\t'}
    done
  done
  for p in ${(f)"$(print -rl -- $wt | open_filter)"}; do [[ -n $p ]] && print -r -- "wt	$(sizek "$p")	$p	$meta[$p]"; done
  psa=$(ps -axo args= 2>/dev/null)
  for p in ${(f)"$(unity_projects)"}; do unity_idle "$p" "$psa" && un+=( "$p" ); done
  for p in ${(f)"$(print -rl -- $un | open_filter)"}; do [[ -n $p ]] && print -r -- "unity	$(sizek "$p/Library")	$p"; done
  return 0
}

dv_reason() {
  case $1 in
    merged:*) t dv_merged ${1#merged:} ;;
    idle:*) t dv_idle ${1#idle:} ;;
  esac
}

lib_empty() {
  local lib=$1/Library
  [[ $lib == /?*/Library && -d $lib && -f $1/ProjectSettings/ProjectVersion.txt ]] || return 1
  if [[ -n $DRY_RUN ]]; then dry "rm -rf ${lib/#$HOME/~}/*"; return 0; fi
  local -a items=( $lib/*(DN) )
  (( ${#items} )) && rm -rf -- $items 2>/dev/null
  ok "${lib/#$HOME/~}"
}

do_dev() {
  title "$T[md]"
  local -a rows=( ${(f)"$(spin "$T[dv_spin]" dev_scan)"} )
  local -a wp wk wr wb wn up uk prr prn f pick
  local -A touched
  local r max=0 i freed=0
  for r in ${rows:#}; do
    f=( "${(@ps:\t:)r}" )
    case $f[1] in
      wt) wk+=( $f[2] ); wp+=( "$f[3]" ); wr+=( "$f[4]" ); wb+=( "$f[5]" ); wn+=( "$f[6]" ) ;;
      unity) uk+=( $f[2] ); up+=( "$f[3]" ) ;;
      prune) prn+=( $f[2] ); prr+=( "$f[3]" ) ;;
    esac
  done
  print "  ${B}$T[dv_wt]${N}\n"
  if (( ${#wp} )); then
    for i in {1..${#wp}}; do (( wk[i] > max )) && max=$wk[i]; done
    for i in {1..${#wp}}; do
      printf "  ${M}%3d${N} %s %9s  ${B}%s${N} ${D}· %s · %s${N}\n" $i "$(bar $wk[i] $max 12)" "$(human $wk[i])" "${wr[i]:t}" "${${wb[i]:#-}:-$T[dv_detached]}" "$(dv_reason $wn[i])"
      print "        ${D}${wp[i]/#$HOME/~}${N}"
    done
  else
    ok "$(t dv_wt_none $DEV_DAYS)"
  fi
  if (( ${#prr} )); then
    for i in {1..${#prr}}; do print "  ${D}$(t dv_prune $prn[i]) · ${prr[i]/#$HOME/~}${N}"; done
  fi
  print
  if (( ${#wp} )); then
    for i in $(sel_idx ${#wp} "$T[dv_wt_pick]"); do pick+=( $i ); done
    if (( ${#pick} )) && confirm "$(t dv_wt_ask ${#pick})"; then
      for i in $pick; do
        touched[$wr[i]]=1
        if [[ -n $DRY_RUN ]]; then dry "git -C ${wr[i]/#$HOME/~} worktree remove ${wp[i]/#$HOME/~}"; (( freed += wk[i] )); continue; fi
        if git -C "$wr[i]" worktree remove "$wp[i]" >/dev/null 2>&1; then ok "${wp[i]/#$HOME/~}"; (( freed += wk[i] ))
        else err "$(t dv_wt_fail "${wp[i]/#$HOME/~}")"; fi
      done
    fi
  fi
  for r in $prr; do touched[$r]=1; done
  for r in ${(k)touched}; do act_q git -C "$r" worktree prune; done
  print "\n  ${B}$T[dv_un]${N}"
  print "  ${Y}!${N} ${D}$T[dv_un_warn]${N}\n"
  if (( ${#up} )); then
    max=0
    for i in {1..${#up}}; do (( uk[i] > max )) && max=$uk[i]; done
    for i in {1..${#up}}; do
      printf "  ${M}%3d${N} %s %9s  %s\n" $i "$(bar $uk[i] $max 12)" "$(human $uk[i])" "${up[i]/#$HOME/~}/Library"
    done
    print
    pick=()
    for i in $(sel_idx ${#up} "$T[dv_un_pick]"); do pick+=( $i ); done
    if (( ${#pick} )) && confirm "$(t dv_un_ask ${#pick})"; then
      for i in $pick; do lib_empty "$up[i]" && (( freed += uk[i] )); done
    fi
  else
    ok "$(t dv_un_none $DEV_DAYS)"
  fi
  (( freed )) || return 0
  print
  log_hist md $freed
  celebrate "$(t dv_done "$(human $freed)")"
}

apfs_report() {
  local cont=$(diskutil info / 2>/dev/null | awk -F': *' '/APFS Container:/{print $2; exit}')
  [[ -n $cont ]] || return 0
  diskutil apfs list $cont 2>/dev/null | awk -v c=$cont '
    function kb(s) { if (!match(s, /[0-9]+ B/)) return 0; return int(substr(s, RSTART, RLENGTH - 2) / 1024) }
    /Size \(Capacity Ceiling\)/ { cap = kb($0) }
    /Capacity In Use By Volumes/ { use = kb($0) }
    /Capacity Not Allocated/ { na = kb($0) }
    /APFS Volume Disk \(Role\)/ { role = $0; sub(/.*\(/, "", role); sub(/\).*/, "", role) }
    /^[| +]*Name:/ { name = $0; sub(/.*Name: */, "", name); sub(/ \(.*/, "", name) }
    /Capacity Consumed/ { print "vol\t" kb($0) "\t" name "\t" role }
    END { print "cont\t" c "\t" cap "\t" use "\t" na }'
}

purgeable_kb() {
  local v=$(osascript -l JavaScript -e 'ObjC.import("Foundation"); var r = $.NSURL.fileURLWithPath("/System/Volumes/Data").resourceValuesForKeysError(["NSURLVolumeAvailableCapacityForImportantUsageKey"], null); r.objectForKey("NSURLVolumeAvailableCapacityForImportantUsageKey").js' 2>/dev/null)
  [[ $v == <-> ]] && print $(( v / 1024 )) || print 0
}

do_system() {
  title "$T[ms]"
  local -a w=( ${=$(sysctl -n vm.swapusage 2>/dev/null)} ) snaps rows f
  print "  $(t sy_swap "${B}$(human $(to_kb ${w[6]:-0}))${N}" "$(human $(to_kb ${w[3]:-0}))")"
  snaps=( ${(M)${(f)"$(tmutil listlocalsnapshots / 2>/dev/null)"}:#com.apple.*} )
  print "  $(t sy_snap "${B}${#snaps}${N}")"
  local s r
  for s in $snaps; do print "      ${D}$s${N}"; done
  rows=( ${(f)"$(spin "$T[sy_spin]" apfs_report)"} )
  for r in ${(M)rows:#cont*}; do
    f=( "${(@ps:\t:)r}" )
    print "  $(t sy_cont $f[2] "${B}$(human $f[4])${N}" "$(human $f[3])" "$(human $f[5])")"
  done
  for r in ${(M)rows:#vol*}; do
    f=( "${(@ps:\t:)r}" )
    printf "      %9s  %s ${D}(%s)${N}\n" "$(human $f[2])" "$f[3]" "$f[4]"
  done
  local fr=$(free_kb) av=$(purgeable_kb)
  (( av < fr )) && av=$fr
  print "  $(t sy_free "${B}$(human $fr)${N}" "$(human $av)" "$(human $(( av - fr )))")\n"
  print "  ${D}$T[sy_reboot]${N}"
  print "  ${D}$T[sy_note]${N}\n"
  confirm "$T[sy_ask]" || return 0
  if [[ -n $DRY_RUN ]]; then dry "sudo tmutil thinlocalsnapshots / 999999999999 4"; dry "sudo purge"; celebrate; return 0; fi
  sudo -p "  ${D}$T[sudo_prompt]${N} " true || return 0
  spin "$T[sy_spin]" sudo tmutil thinlocalsnapshots / 999999999999 4 >/dev/null
  spin "$T[ram_spin]" sudo purge
  local after=$(free_kb)
  log_hist ms $(( after > fr ? after - fr : 0 ))
  celebrate "$(t sy_done "$(human $fr)" "$(human $after)")"
}

do_auto() {
  title "$T[m9]"
  print "  ${D}$T[au_desc]${N}\n"
  NM_LIST=$(mktemp -t mac-cleaner)
  apps_split
  local -a rows=( ${(f)"$(spin "$T[ca_spin]" scan_caches $SAFE_KEYS)"} )
  rows=( ${rows:#} )
  temp_collect
  local tk=$(sizek $TRASH_DIR/*(DN)) r s total=0
  for r in $rows; do
    s=${r#*$'\t'}; (( total += s ))
    printf "  %9s  %s\n" "$(human $s)" "$(cache_label ${r%%$'\t'*})"
  done
  printf "  %9s  %s\n" "$(human $TE_KB)" "$T[mt]"
  printf "  %9s  %s\n" "$(human $tk)" "$T[trash_title]"
  (( total += tk + TE_KB ))
  print
  skip_note ca_skip $CA_KEEP
  skip_note te_skip $TE_KEEP
  print "\n  ${B}$(t total "$(human $total)")${N}\n"
  confirm "$T[au_ask]" || { rm -f $NM_LIST; return 0 }
  for r in $rows; do cache_clean ${r%%$'\t'*}; done
  temp_clean
  empty_trash
  rm -f $NM_LIST
  log_hist m9 $total
  print
  celebrate "$(t ca_done "$(human $total)")"
}

dl_scan() {
  local f
  find "$HOME/Downloads" -mindepth 1 -maxdepth 1 -not -name '.*' -mtime +$1 2>/dev/null | while IFS= read -r f; do
    print -r -- "$(sizek "$f")	$(stat -f %m "$f")	$f"
  done | sort -t$'\t' -k1,1nr | head -40
}

do_downloads() {
  title "$T[m6]"
  local days
  ask days "$T[dl_days] ${D}[90]${N}"
  [[ $days == <1-> ]] || days=90
  local -a rows=( ${(f)"$(spin "$T[dl_spin]" dl_scan $days)"} )
  rows=( ${rows:#} )
  (( ${#rows} )) || { warn "$(t dl_none $days)"; return 0 }
  local -a paths psz
  local now=$(date +%s) i=1 r sz mt p max=${rows[1]%%$'\t'*}
  for r in $rows; do
    sz=${r%%$'\t'*}; mt=${${r#*$'\t'}%%$'\t'*}; p=${r#*$'\t'*$'\t'}
    paths+=( "$p" ); psz+=( $sz )
    printf "  ${M}%3d${N} %s %9s  ${D}%6s${N}  %s\n" $i "$(bar $sz $max 12)" "$(human $sz)" "$(t dl_age $(( (now - mt) / 86400 )))" "${p:t}"
    (( i++ ))
  done
  print
  local sel k=0
  ask sel "$T[pick]"
  local -a pick
  for i in $(pick_idx "$sel" ${#paths}); do pick+=( "${paths[i]}" ); (( k += psz[i] )); done
  (( ${#pick} )) || return 0
  confirm "$(t lg_ask ${#pick} "$(human $k)")" || return 0
  to_trash $pick
  log_hist m6 $k
  celebrate "$(t lg_done "$(human $k)")"
}

st_scan() {
  local f label kind state names
  if [[ -z $MAC_CLEANER_TEST ]]; then
    names=$(osascript -e 'tell application "System Events" to get the name of every login item' 2>/dev/null)
    for f in ${(s:, :)names}; do [[ -n $f ]] && print -r -- "login	on	$f	$f"; done
  fi
  for f in $HOME/Library/LaunchAgents/*.plist /Library/LaunchAgents/*.plist /Library/LaunchDaemons/*.plist; do
    label=$(/usr/libexec/PlistBuddy -c 'Print :Label' "$f" 2>/dev/null) || label=${f:t:r}
    [[ $label == com.apple.* ]] && continue
    case $f in
      $HOME/*) kind=agent ;;
      /Library/LaunchAgents/*) kind=sysagent ;;
      *) kind=daemon ;;
    esac
    if [[ $kind == daemon ]]; then launchctl print system/$label >/dev/null 2>&1 && state=on || state=off
    else launchctl list "$label" >/dev/null 2>&1 && state=on || state=off; fi
    print -r -- "$kind	$state	$label	$f"
  done
}

st_disable() {
  local kind=$1 label=$2 f=$3
  case $kind in
    login) act_q osascript -e "tell application \"System Events\" to delete login item \"$label\"" ;;
    agent) act_q launchctl bootout gui/$UID "$f"; to_trash "$f" ;;
    sysagent) act_q sudo launchctl bootout gui/$UID "$f"; to_trash "$f" ;;
    daemon) act_q sudo launchctl bootout system "$f"; to_trash "$f" ;;
  esac
}

do_startup() {
  title "$T[m7]"
  local -a rows=( ${(f)"$(spin "$T[st_spin]" st_scan)"} )
  rows=( ${rows:#} )
  (( ${#rows} )) || { ok "$T[st_none]"; return 0 }
  local -a kinds labels files
  local i=1 r kind state label f dot
  for r in $rows; do
    kind=${r%%$'\t'*}; r=${r#*$'\t'}; state=${r%%$'\t'*}; r=${r#*$'\t'}; label=${r%%$'\t'*}; f=${r#*$'\t'}
    kinds+=( $kind ); labels+=( "$label" ); files+=( "$f" )
    [[ $state == on ]] && dot="${G}●${N}" || dot="${D}○${N}"
    printf "  ${M}%3d${N} %s  %-38s ${D}%s${N}\n" $i "$dot" "$label" "$T[st_$kind]"
    (( i++ ))
  done
  print "\n  ${D}$T[st_note]${N}\n"
  local sel
  ask sel "$T[st_pick]"
  local -a pick
  for i in $(pick_idx "$sel" ${#labels}); do pick+=( $i ); done
  (( ${#pick} )) || return 0
  confirm "$(t st_ask ${#pick})" || return 0
  if [[ -z $DRY_RUN ]] && (( ${kinds[(I)sysagent]} || ${kinds[(I)daemon]} )); then
    for i in $pick; do [[ ${kinds[i]} == (sysagent|daemon) ]] && { sudo -p "  ${D}$T[sudo_prompt]${N} " -v || return 0; break }; done
  fi
  local done_labels=()
  for i in $pick; do st_disable ${kinds[i]} "${labels[i]}" "${files[i]}"; ok "${labels[i]}"; done_labels+=( "${labels[i]}" ); done
  log_hist m7 0 "${(j:, :)done_labels}"
  print
  celebrate "$(t st_done ${#pick})"
}

du_scan() {
  local dir=$1 min=$2 size f h
  find "$dir" -xdev \( -path "$HOME/Library" -o -path "$HOME/.Trash" -o -name "*.app" -o -name node_modules -o -name .git \) -prune -o -type f -size +${min}M -print0 2>/dev/null \
    | xargs -0 stat -f $'%z\t%N' 2>/dev/null \
    | awk -F'\t' '{ c[$1]++; l[NR] = $0; s[NR] = $1 } END { for (i = 1; i <= NR; i++) if (c[s[i]] > 1) print l[i] }' \
    | while IFS=$'\t' read -r size f; do h=$(md5 -q "$f" 2>/dev/null) && print -r -- "$h	$size	$(stat -f %m "$f")	$f"; done \
    | sort -t$'\t' -k1,1 -k3,3n \
    | awk -F'\t' '{ c[$1]++; l[NR] = $0; h[NR] = $1 } END { for (i = 1; i <= NR; i++) if (c[h[i]] > 1) print l[i] }'
}

do_dupes() {
  title "$T[m8]"
  local dir min
  ask dir "$T[du_dir]"
  dir=${dir/#\~/$HOME}; dir=${dir:-$HOME}
  [[ -d $dir ]] || { err "$(t du_bad "$dir")"; return 0 }
  ask min "$T[lg_min] ${D}[1]${N}"
  [[ $min == <1-> ]] || min=1
  local -a rows=( ${(f)"$(spin "$T[du_spin]" du_scan "$dir" $min)"} )
  rows=( ${rows:#} )
  (( ${#rows} )) || { ok "$T[du_none]"; return 0 }
  local -a gstart gend
  local i prev= h
  for i in {1..${#rows}}; do
    h=${rows[i]%%$'\t'*}
    if [[ $h != $prev ]]; then (( ${#gstart} )) && gend+=( $(( i - 1 )) ); gstart+=( $i ); prev=$h; fi
  done
  gend+=( ${#rows} )
  local g j sz p
  for g in {1..${#gstart}}; do
    sz=${${rows[gstart[g]]#*$'\t'}%%$'\t'*}
    print "  ${M}$(t du_group $g $(( gend[g] - gstart[g] + 1 )) "$(human $(( sz / 1024 )))")${N}"
    for j in {${gstart[g]}..${gend[g]}}; do
      p=${rows[j]#*$'\t'*$'\t'*$'\t'}
      if (( j == gstart[g] )); then print "     ${G}$T[du_keep]${N}  ${p/#$HOME/~}"
      else print "     ${R}✘${N}      ${p/#$HOME/~}"; fi
    done
  done
  print
  local sel k=0
  ask sel "$T[du_pick]"
  local -a pick
  for g in $(pick_idx "$sel" ${#gstart}); do
    for j in {$(( gstart[g] + 1 ))..${gend[g]}}; do
      pick+=( "${rows[j]#*$'\t'*$'\t'*$'\t'}" )
      (( k += ${${rows[j]#*$'\t'}%%$'\t'*} / 1024 ))
    done
  done
  (( ${#pick} )) || return 0
  confirm "$(t du_ask ${#pick} "$(human $k)")" || return 0
  to_trash $pick
  log_hist m8 $k
  celebrate "$(t du_done "$(human $k)")"
}

do_history() {
  title "$T[mh]"
  [[ -s $HIST_FILE ]] || { warn "$T[hi_empty]"; return 0 }
  local line d a k x
  for line in ${(f)"$(tail -n 20 $HIST_FILE)"}; do
    IFS=$'\t' read -r d a k x <<< "$line"
    printf "  ${D}%s${N}  %-30s %9s  ${D}%s${N}\n" "$d" "$T[$a]" "$( (( k )) && human $k || print -n -)" "$x"
  done
  print "\n  ${B}$(t hi_total "$(human $(awk -F'\t' '{s+=$3} END{print s+0}' $HIST_FILE))")${N}"
}

menu_item() { printf "  ${D}│${N}  ${M}%s${N}  ${B}%s${N}  %-38s${D}│${N}\n" "$1" "$2" "$3" }

menu() {
  local first=1 c=
  while true; do
    [[ -n $FANCY ]] && print -n "\e[H\e[2J"
    print
    draw_logo $(( first ? 10 : 1 )); first=0
    overview
    [[ -n $DRY_RUN ]] && print "\n  ${Y}✦ $T[dry_badge]${N}"
    print "\n  ${D}╭──────────────────────────────────────────────╮${N}"
    menu_item ✦ 1 "$T[m1]"
    menu_item ✧ 2 "$T[m2]"
    menu_item ✦ 3 "$T[m3]"
    menu_item ✧ 4 "$T[m4]"
    menu_item ✦ 5 "$T[m5]"
    menu_item ✧ 6 "$T[m6]"
    menu_item ✦ 7 "$T[m7]"
    menu_item ✧ 8 "$T[m8]"
    menu_item ✦ 9 "$T[m9]"
    menu_item ✧ t "$T[mt]"
    menu_item ✦ d "$T[md]"
    menu_item ✧ s "$T[ms]"
    menu_item ✧ h "$T[mh]"
    menu_item ⋆ q "$T[mq]"
    print "  ${D}╰──────────────────────────────────────────────╯${N}\n"
    c=
    key c "  ${M}›${N} " || exit 0
    print "$c"
    case $c in
      1) do_ram ;;
      2) do_trash ;;
      3) do_uninstall ;;
      4) do_large ;;
      5) do_caches ;;
      6) do_downloads ;;
      7) do_startup ;;
      8) do_dupes ;;
      9) do_auto ;;
      t|T) do_temp ;;
      d|D) do_dev ;;
      s|S) do_system ;;
      h|H) do_history ;;
      q|Q) print "  ${Y}✦${N} ${D}$T[bye]${N}\n"; exit 0 ;;
      *) continue ;;
    esac
    print
    pause
  done
}

usage() {
  print "$(t usage $SCRIPT)\n"
  printf "  %-14s %s\n" ram "$T[u_ram]" trash "$T[u_trash]" uninstall "$T[u_un]" large "$T[u_lg]" caches "$T[u_ca]" \
    downloads "$T[u_dl]" startup "$T[u_st]" duplicates "$T[u_du]" temp "$T[u_te]" dev "$T[u_dv]" system "$T[u_sy]" \
    auto "$T[u_auto]" history "$T[u_hist]"
  print "  $T[u_menu]\n"
  print "  $T[u_dry]\n  $T[u_yes]"
}

case $CMD in
  ram) do_ram ;;
  corbeille|trash) do_trash ;;
  desinstaller|uninstall) do_uninstall ;;
  gros|large) do_large ;;
  caches) do_caches ;;
  telechargements|downloads) do_downloads ;;
  demarrage|startup) do_startup ;;
  doublons|duplicates) do_dupes ;;
  temp|temporaires) do_temp ;;
  dev) do_dev ;;
  systeme|system) do_system ;;
  auto) do_auto ;;
  historique|history) do_history ;;
  ""|menu) menu ;;
  -v|--version) print "mac-cleaner $VERSION" ;;
  -h|--help) usage ;;
  *) usage; exit 1 ;;
esac
